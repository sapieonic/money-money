# Optional explicit backend config. Copy to backends/<stage>.s3.tfbackend to
# override the defaults scripts/tf.mjs derives from TF_STATE_BUCKET.
# Use a different `key` per stage so dev and prod never share state.

bucket       = "finance-watch-tfstate-123456789012"
key          = "finance-watch/prod/terraform.tfstate"
region       = "ap-south-1"
encrypt      = true
use_lockfile = true
